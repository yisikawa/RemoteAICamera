# config.yaml.example — このファイルを config.yaml にコピーして編集してください
# cp config.yaml.example config.yaml

cameras:
  - name: "frontCamera"
    host: "192.168.1.100"

    # Tapo API 認証 (pytapo / KLAP protocol 用)
    api_username: "admin"                          # Tapo API 用ユーザー (通常は "admin")
    api_password: "your_tplink_cloud_password"     # TP-Link ID のパスワード

    # RTSP/ONVIF 認証 (ローカルカメラアカウント用)
    stream_username: "your_stream_username"        # カメラアカウント (Tapo app で作成)
    stream_password: "your_stream_password"        # カメラアカウント パスワード

    rtsp_stream: 1                  # 1=高画質, 2=低画質
    reconnect_interval: 5
    motion_poll_interval: 2

  # カメラを追加する場合はこのブロックをコピーして追記
  # - name: "garageCamera"
  #   host: "192.168.1.101"
  #   api_username: "admin"
  #   api_password: "your_tplink_cloud_password"
  #   stream_username: "your_stream_username"
  #   stream_password: "your_stream_password"
  #   rtsp_stream: 1
  #   reconnect_interval: 5
  #   motion_poll_interval: 2

detection:
  yolo_model: "yolov8s.pt"         # n/s/m/l/x から選択 (s推奨)
  confidence: 0.5
  target_classes:
    - 0    # person
    - 1    # bicycle
    - 2    # car
    - 3    # motorcycle
    - 5    # bus
    - 7    # truck
  device: "cuda"                   # cuda / cpu
  frame_skip: 2

storage:
  base_dir: "data"
  snapshots_dir: "data/snapshots"
  clips_dir: "data/clips"
  faces_dir: "data/faces"
  db_path: "data/events.db"
  snapshot_quality: 90
  clip_pre_seconds: 3           # ONVIF駆動型: プリロール 3秒
  clip_post_seconds: 12         # ONVIF駆動型: ポストロール 12秒 (3+12=15秒クリップ)
  clip_duration_sec: 15         # 総クリップ長
  max_storage_gb: 50

ollama:
  base_url: "http://localhost:11434/v1"
  vision_model: "qwen2.5vl:7b"   # 画像類似判定用 (Phase 3)
  chat_model: "qwen2.5:7b"       # チャット用 (将来)
  timeout: 30

logging:
  level: "INFO"                    # DEBUG / INFO / WARNING / ERROR
  file: "data/app.log"
